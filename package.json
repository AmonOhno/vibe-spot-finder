{
  "name": "vibe-spot-finder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:record": "RECORD=1 playwright test",
    "fixtures": "python3 scripts/generate_fixtures.py"
  },
  "dependencies": {
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
